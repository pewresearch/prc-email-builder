{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "prc-email-builder/campaign-email-preview",
  "version": "0.1.0",
  "title": "Campaign Email Preview",
  "category": "theme",
  "description": "Renders a phone-width, cropped live preview of a campaign's email HTML.",
  "keywords": [
    "email",
    "newsletter",
    "preview",
    "campaign"
  ],
  "textdomain": "prc-email-builder",
  "attributes": {
    "frameWidth": {
      "type": "number",
      "default": 375
    },
    "frameHeight": {
      "type": "number",
      "default": 560
    },
    "showFade": {
      "type": "boolean",
      "default": true
    },
    "showLink": {
      "type": "boolean",
      "default": true
    },
    "linkText": {
      "type": "string",
      "default": "Read the latest issue"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ]
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
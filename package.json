{
	"name": "@prc/email-builder",
	"version": "1.1.0",
	"description": "PRC Email Builder provides email authoring and delivery functionality for PRC Platform.",
	"scripts": {
		"build": "wp-scripts build && wp-scripts build --config webpack.settings.config.js && wp-scripts build --config webpack.library.config.js",
		"build:settings": "wp-scripts build --config webpack.settings.config.js",
		"build:library": "wp-scripts build --config webpack.library.config.js",
		"start:settings": "wp-scripts start --config webpack.settings.config.js",
		"start:library": "wp-scripts start --config webpack.library.config.js",
		"test": "wp-scripts test-playwright"
	},
	"devDependencies": {
		"@playwright/test": "^1.51.1",
		"@wordpress/e2e-test-utils-playwright": "^1.21.0",
		"@wordpress/scripts": "^31.4.0"
	},
	"dependencies": {
		"@prc/components": "*",
		"@wordpress/dataviews": "^4.19.0",
		"@wordpress/icons": "^10.21.0"
	},
	"license": "GPL-2.0-or-later"
}
